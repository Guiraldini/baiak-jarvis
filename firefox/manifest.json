{
  "manifest_version": 3,
  "name": "Baiak Jarvis AUTO",
  "version": "0.8.3",
  "description": "Copiloto local para acompanhar e automatizar o ciclo de stamina no Baiak Idle.",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": [
    "https://baiakidle.com/*",
    "https://www.baiakidle.com/*",
    "https://guiabaiakidle.com/*"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "baiak-jarvis@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://baiakidle.com/jogar/*",
        "https://www.baiakidle.com/jogar/*"
      ],
      "js": ["src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Baiak Jarvis",
    "default_popup": "popup/popup.html"
  }
}
