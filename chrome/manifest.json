{
  "manifest_version": 3,
  "name": "Baiak Jarvis AUTO",
  "version": "0.8.17",
  "description": "Copiloto local para stamina, treino em casa, hunts, Codex, sets e chefes favoritos no Baiak Idle.",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": [
    "https://baiakidle.com/*",
    "https://www.baiakidle.com/*",
    "https://guiabaiakidle.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://baiakidle.com/jogar/*",
        "https://www.baiakidle.com/jogar/*"
      ],
      "js": ["src/codex-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://baiakidle.com/jogar/*",
        "https://www.baiakidle.com/jogar/*"
      ],
      "js": ["src/equipment-catalog.js", "src/codex-catalog.js", "src/core.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Baiak Jarvis",
    "default_popup": "popup/popup.html"
  }
}
